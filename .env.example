# Supabase: prisma db push/migrate 는 반드시 직접 연결(포트 5432)만 가능.
# Supabase → 연결 문자열 → 방법을 "세션 풀러" 또는 "직접" (5432) 로 선택한 URI 사용. 끝에 ?sslmode=require
DATABASE_URL="postgresql://postgres.xxxx:비밀번호@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# NextAuth (필요 시)
# AUTH_SECRET="your-secret"
# NEXTAUTH_URL="http://localhost:3000"
