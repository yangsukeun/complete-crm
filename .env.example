# ============================================
# 로컬 개발 = 배포와 동일한 DB·로그인을 쓰려면
# ============================================
# Vercel(또는 배포 환경) → Project → Settings → Environment Variables 에서
# 아래 값을 복사해 .env.local 에 넣으세요. (로컬 전용 DB를 쓰면 복사 불필요)
#
# 필수 (배포 DB와 동일):
#   DATABASE_URL
#
# 인증 (배포와 같게 두면 세션/토큰 동작이 동일합니다. 비워두면 개발용 기본값 사용)
#   AUTH_SECRET 또는 NEXTAUTH_SECRET  ← Vercel에 설정된 값과 동일 권장
#   NEXTAUTH_URL=http://localhost:3000  ← 로컬에서는 항상 로컬 주소
#
# --- Supabase 권장 분리 ---
# DATABASE_URL = Transaction pooler (예: *.pooler.supabase.com:6543) → 앱(Next.js)이 사용
# DIRECT_URL   = 직접 연결 포트 5432 → prisma migrate / db push만 사용 (대시보드 Database → URI)
# 둘 다 5432 직접 연결만 쓴다면 아래 두 줄에 동일한 URI를 넣으면 됨.
#
# DATABASE_URL="postgresql://postgres.[ref]:비번@aws-0-....pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.[ref]:비번@aws-0-....pooler.supabase.com:5432/postgres?sslmode=require"

DATABASE_URL="postgresql://postgres.xxxx:비밀번호@db.xxxx.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.xxxx:비밀번호@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# Supabase Realtime (채팅·알림 폴링 대체) — Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  (anon / public)
# SUPABASE_JWT_SECRET=...  (JWT Secret — 서버에서만 보관, realtime-token 서명용)
# DB에 RLS·publication 적용: prisma/supabase-realtime.sql

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ========== 파일 저장소 (/api/upload) ==========
# STORAGE_PROVIDER=auto (기본) | vercel-blob | google-drive | webdav | local
# auto: Vercel에서는 Drive(서비스 계정) 설정 시 Drive 우선 → WebDAV → Blob. 로컬은 Blob 또는 local.
# /api/upload 단일 파일 최대 100MB (초과 시 NAS 등 별도 연동 예정 메시지)
#
# --- Vercel Blob (기존) ---
# BLOB_READ_WRITE_TOKEN=
#
# --- Google Drive (서비스 계정) ---
# 1) GCP에서 서비스 계정 JSON 발급 → Drive API 사용 설정
# 2) 드라이브에서 업로드용 폴더 생성 → 해당 폴더를 서비스 계정 이메일에 "편집자"로 공유
# 3) 폴더 ID(주소창 /folders/ 뒤) 설정 — 업로드 자동저장 전용 (변경·재사용 금지)
# GOOGLE_DRIVE_FOLDER_ID=
# 4) /drive 탐색기 전용 공유 드라이브 ID (미설정 시 FOLDER_ID로 폴백 — 현행 유지)
# GOOGLE_DRIVE_EXPLORER_FOLDER_ID=
# 아래 중 하나: JSON 한 줄(따옴표 이스케이프) 또는 이메일+개인키 분리
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@....iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 업로드 직후 "링크가 있는 모든 사용자" 읽기 권한을 자동 부여(본문 이미지 표시용). 조직 정책상 불가하면 아래를 1
# GOOGLE_DRIVE_SKIP_PUBLIC_PERMISSION=
#
# --- NAS / WebDAV (시놀로지 WebDAV Server 등) — 업로드 저장소용, 탐색기와 무관 ---
# WEBDAV_URL=https://your-nas:5006/경로 (DSM WebDAV 도움말의 기본 URL 형식에 맞출 것)
# WEBDAV_USER=
# WEBDAV_PASSWORD=
# 원격 상대 경로 접두 (슬래시 없이)
# WEBDAV_SUBPATH=crm-uploads/board-content
# 브라우저에서 파일 URL을 만들 때 필요 (HTTPS 공개 경로, 슬래시 없이)
# WEBDAV_PUBLIC_BASE_URL=https://files.example.com/share
#
# 주 저장소에 추가로 NAS에만 복제 (Blob/Drive → WebDAV 이중화). WEBDAV_* 필수, PUBLIC_BASE는 미러에는 불필요
# STORAGE_MIRROR_WEBDAV=false
#
# --- NAS 문서함 탐색기 (/nas-drive) — File Station API (WebDAV·GOOGLE_DRIVE_* 와 절대 혼용 금지) ---
# NAS_QUICKCONNECT_URL=https://complete2020.quickconnect.to
# NAS_SERVICE_ACCOUNT_USER=
# NAS_SERVICE_ACCOUNT_PASSWORD=
# NAS_DOCUMENTS_SHARE_PATH=/문서공유
# 선택: QuickConnect가 Vercel에서 HTML 릴레이만 줄 때 DSM 직접 base (예: https://xxx.direct.quickconnect.to:5001)
# NAS_API_BASE_URL=

# 초기 마스터 계정 seed (prisma db seed) — 선택
# MASTER_EMAIL=admin@complete.co.kr
# MASTER_PASSWORD=1234

# ========== AI (채팅·업무지시 등) ==========
# AI_PROVIDER=gemini | openai | notebook | claude
# Claude (권장 변수명 — Anthropic과 동일 키를 ANTHROPIC_API_KEY로도 허용)
# CLAUDE_API_KEY=sk-ant-api03-...
# CLAUDE_MODEL=claude-3-5-sonnet-20241022   # 선택. 미설정 시 코드 기본값 사용
# GEMINI_API_KEY=   # Google AI Studio 등 (Gemini 사용 시)
# GEMINI_MODEL=gemini-1.5-flash   # 선택. 404 시 코드가 다른 모델로 자동 재시도할 수 있음
# OPENAI_API_KEY=   # OpenAI (ChatGPT 사용 시)
# OPENAI_MODEL=     # 선택. 미설정 시 gpt-4o-mini

# --- AI 허브 (/ai-hub) — 대표·임원 전용 (고급 모델). 미설정 시 위 공용 키로 폴백 ---
# EXECUTIVE_ANTHROPIC_API_KEY=
# EXECUTIVE_OPENAI_API_KEY=
# EXECUTIVE_GEMINI_API_KEY=

# --- AI 허브 — 직원용 (일반 모델). 미설정 시 공용 키로 폴백. 직원은 Claude 미사용(GPT+Gemini만 비교) ---
# STAFF_OPENAI_API_KEY=
# STAFF_GEMINI_API_KEY=

# 공개 사이트 URL (푸시/링크 절대 경로용)
# NEXT_PUBLIC_SITE_URL=https://www.cpcrm.co.kr
# 푸시(web_url·아이콘) 전용 origin — 미설정 시 vercel.app 은 무시하고 아래 운영 도메인으로 폴백
# NEXT_PUBLIC_PUSH_ORIGIN=https://www.cpcrm.co.kr
#
# Vercel Cron 보안 — /api/cron/* 호출 시 Authorization: Bearer 와 동일 값 필수
# CRON_SECRET=긴_무작위_문자열
#
# OneSignal 구독 좀비 정리(/api/cron/cleanup-onesignal-subscriptions): lastSeenAt 기준 일수 (기본 90)
# ONESIGNAL_SUBSCRIPTION_STALE_DAYS=90
#
# OneSignal 웹 푸시 — Vercel에는 아래 둘 다 필수(Production + Preview 필요 시 동일 설정)
# NEXT_PUBLIC_ONESIGNAL_APP_ID=   # 앱 ID (브라우저 OneSignal.init)
# ONESIGNAL_REST_API_KEY=         # REST API Key (서버 발송 전용, 절대 NEXT_PUBLIC 금지)
# ONE_SIGNAL_REST_API_KEY=        # 선택: 오타 방지용 폴백(코드에서 ONESIGNAL_REST_API_KEY와 동일 취급)
# 미설정 시 GET /api/test-push 가 503 + missing 목록으로 알림
# 서버는 레거시 POST https://onesignal.com/api/v1/notifications (Basic) 후 실패 시
#       POST https://api.onesignal.com/notifications (Authorization: Key …) 재시도
# ONESIGNAL_APP_ID=               # 선택: 서버 전용 App ID (없으면 NEXT_PUBLIC 값 사용)
# 푸시 디버그 (Vercel 로그 / 브라우저 콘솔에 단계별 로그)
# DEBUG_ONESIGNAL=1
# NEXT_PUBLIC_DEBUG_ONESIGNAL=1
# NEXT_PUBLIC_DEBUG_TOKEN_MOBILE=1   # 모바일 토큰 등록: [TOKEN-MOBILE] 로그 + 화면 고정 패널(배포 후 원격 확인용)

# AI 비서: Gemini에 넘기는 system 프롬프트 전체를 Vercel 로그에 출력 (개발 모드에서도 전체 출력)
# DEBUG_AI_SECRETARY_SYSTEM=1
