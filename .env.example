# ============================================
# 로컬 개발 = 배포와 동일한 DB·로그인을 쓰려면
# ============================================
# Vercel(또는 배포 환경) → Project → Settings → Environment Variables 에서
# 아래 값을 복사해 .env.local 에 넣으세요. (로컬 전용 DB를 쓰면 복사 불필요)
#
# 필수 (배포 DB와 동일):
#   DATABASE_URL
#
# 인증 (배포와 같게 두면 세션/토큰 동작이 동일합니다. 비워두면 개발용 기본값 사용)
#   AUTH_SECRET 또는 NEXTAUTH_SECRET  ← Vercel에 설정된 값과 동일 권장
#   NEXTAUTH_URL=http://localhost:3000  ← 로컬에서는 항상 로컬 주소
#
# --- Supabase 권장 분리 ---
# DATABASE_URL = Transaction pooler (예: *.pooler.supabase.com:6543) → 앱(Next.js)이 사용
# DIRECT_URL   = 직접 연결 포트 5432 → prisma migrate / db push만 사용 (대시보드 Database → URI)
# 둘 다 5432 직접 연결만 쓴다면 아래 두 줄에 동일한 URI를 넣으면 됨.
#
# DATABASE_URL="postgresql://postgres.[ref]:비번@aws-0-....pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL="postgresql://postgres.[ref]:비번@aws-0-....pooler.supabase.com:5432/postgres?sslmode=require"

DATABASE_URL="postgresql://postgres.xxxx:비밀번호@db.xxxx.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.xxxx:비밀번호@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ========== 파일 저장소 (/api/upload) ==========
# STORAGE_PROVIDER=auto (기본) | vercel-blob | google-drive | webdav | local
# auto: BLOB 토큰 있으면 Blob → Vercel에서는 Drive/WebDAV 설정 시 그쪽 우선
#
# --- Vercel Blob (기존) ---
# BLOB_READ_WRITE_TOKEN=
#
# --- Google Drive (서비스 계정) ---
# 1) GCP에서 서비스 계정 JSON 발급 → Drive API 사용 설정
# 2) 드라이브에서 업로드용 폴더 생성 → 해당 폴더를 서비스 계정 이메일에 "편집자"로 공유
# 3) 폴더 ID(주소창 /folders/ 뒤) 설정
# GOOGLE_DRIVE_FOLDER_ID=
# 아래 중 하나: JSON 한 줄(따옴표 이스케이프) 또는 이메일+개인키 분리
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@....iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 링크로 열람 허용(누구나 보기) — 민감 파일에는 쓰지 마세요
# GOOGLE_DRIVE_ANYONE_READER=false
#
# --- NAS / WebDAV (시놀로지 WebDAV Server 등) ---
# WEBDAV_URL=https://your-nas:5006/경로 (DSM WebDAV 도움말의 기본 URL 형식에 맞출 것)
# WEBDAV_USER=
# WEBDAV_PASSWORD=
# 원격 상대 경로 접두 (슬래시 없이)
# WEBDAV_SUBPATH=crm-uploads/board-content
# 브라우저에서 파일 URL을 만들 때 필요 (HTTPS 공개 경로, 슬래시 없이)
# WEBDAV_PUBLIC_BASE_URL=https://files.example.com/share
#
# 주 저장소에 추가로 NAS에만 복제 (Blob/Drive → WebDAV 이중화). WEBDAV_* 필수, PUBLIC_BASE는 미러에는 불필요
# STORAGE_MIRROR_WEBDAV=false

# 초기 마스터 계정 seed (prisma db seed) — 선택
# MASTER_EMAIL=admin@complete.co.kr
# MASTER_PASSWORD=1234

# ========== AI (채팅·업무지시 등) ==========
# AI_PROVIDER=gemini | openai | notebook
# GEMINI_API_KEY=   # Google AI Studio 등에서 발급 (배포 시 Vercel Environment Variables에 필수)
# GEMINI_MODEL=gemini-2.0-flash   # 선택. 404 시 코드가 다른 모델로 자동 재시도할 수 있음

# OneSignal 웹 푸시 (대시보드 Keys & IDs — REST API Key는 서버 전용, App ID는 클라이언트에 노출됨)
# NEXT_PUBLIC_ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=   # 또는 대시보드의 "REST API Key" (서버에서 알림 전송)
# ONESIGNAL_APP_ID=         # 선택: 서버만 쓸 때 (미설정 시 NEXT_PUBLIC 값과 동일해도 됨)
