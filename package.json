{
  "name": "complete-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:fresh": "node scripts/clear-dev-lock.js && next dev --webpack -p 3000",
    "build": "node scripts/prisma-with-env.cjs generate && next build",
    "postinstall": "node scripts/prisma-with-env.cjs generate",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/prisma-with-env.cjs db push",
    "db:migrate": "node scripts/prisma-with-env.cjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-with-env.cjs migrate dev",
    "db:migrate:status": "node scripts/prisma-with-env.cjs migrate status",
    "db:validate": "node scripts/prisma-with-env.cjs validate",
    "db:baseline": "node scripts/baseline-migrations.cjs",
    "db:seed": "prisma db seed",
    "check-user": "tsx scripts/check-user.ts",
    "check-db": "tsx scripts/check-db-connection.ts",
    "analyze": "cross-env ANALYZE=true node scripts/prisma-with-env.cjs generate && cross-env ANALYZE=true next build --webpack"
  },
