{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/archive-tasks",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/detect-orphan-tasks",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/detect-stale-tasks",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/due-date-alerts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/hard-delete",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/cleanup-onesignal-subscriptions",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/leave-daily",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/expire-leaves",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/revoke-drive-preview-permissions",
      "schedule": "15 * * * *"
    }
  ]
}
