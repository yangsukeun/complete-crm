generator client {
  provider = "prisma-client-js"
}

// 앱 쿼리: DATABASE_URL (Supabase Transaction pooler 6543 가능)
// migrate/deploy/db pull: DIRECT_URL (직접 연결 5432 권장 — 풀러에서는 마이그레이션이 비거나 실패하기 쉬움)
// 둘 다 직접 연결만 쓰면 두 변수에 같은 URI 넣으면 됨.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



enum Role {
  USER
  TEAM_LEAD     // 팀장: 휴가 1차 승인, 자금이체 결재(확인)
  CENTER_CHIEF  // 센터장: CS팀 2차 결재
  EXECUTIVE     // 대표/임원: 휴가 2차 승인, 자금이체 완료 내역만 조회, 회사/직원 관리
  ADMIN         // 레거시: 코드에서 EXECUTIVE와 동일 취급
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// 업무(Task) 생성 경로 — 기존 행은 UNKNOWN, 신규는 호출부에서 명시
enum TaskCreationSource {
  PROJECT
  MINDMAP
  SCHEDULE
  MEMO
  UNKNOWN
}

/// 브랜드 프로젝트(일정 캘린더 마감 칩 등)
enum ProjectStatus {
  PREPARING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

/// 기록기 엑셀 임포트 vs 관리자 수동
enum AttendanceRecordSource {
  MACHINE_IMPORT
  MANUAL
}

enum AwayType {
  BATHROOM
  SMOKING
  AWAY
}

enum LeaveType {
  ANNUAL    // 연차
  HALF_AM   // 오전 반차
  HALF_PM   // 오후 반차
  QUARTER_AM  // 오전 반반차
  QUARTER_PM  // 오후 반반차
  SICK_PAID   // 유급병가
  SICK_UNPAID // 무급병가
}

enum LeaveRequestStatus {
  PENDING            // 신청됨 → 팀장 1차 승인 대기
  TEAM_LEAD_APPROVED // 팀장 1차 승인 → 대표 2차 승인 대기
  APPROVED           // 대표 2차 승인 (최종)
  CANCEL_REQUESTED   // 취소 요청됨 (승인 단계에 따라 처리)
  CANCELLED          // 취소 완료
  REJECTED
}

/// 근로기준법 §60·§61 정합 연차·월차 발생 단위
enum LeaveAccrualType {
  MONTHLY_UNDER_ONE_YEAR // §60② 1년차 월차
  ANNUAL_AFTER_ONE_YEAR  // §60① 1년 만근 연차(매 입사기념일 15일)
  TENURE_BONUS           // §60④ 근속 가산
  CARRY_OVER             // 레거시 이월·실사용차감 호환
  MANUAL_ADJUSTMENT      // 관리자 가감 조정
}

enum CsLoungePostType {
  NOTICE
  LOUNGE
}

enum CsLoungeVoteValue {
  LIKE
  DISLIKE
}

enum ScheduleInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentRequestStatus {
  PENDING                // 신청됨 → 팀장(일반) 또는 대표(이체담당자 요청) 승인 대기
  CENTER_CHIEF_APPROVED  // CS팀 전용: 팀장 1차 승인 완료 → 센터장 2차 승인 대기
  EXECUTIVE_PENDING      // 팀장(또는 CS 센터장) 승인 완료 → 대표 최종 승인 대기
  TEAM_LEAD_APPROVED     // 대표 최종 승인 완료 → 이체 담당자 이체 대기
  COMPLETED              // 이체 담당자가 이체 완료 처리
  REJECTED
}

enum QuotationStatus {
  DRAFT             // 대기(기존)
  SENT              // 발송(기존)
  ACCEPTED          // 수락(기존)
  REJECTED          // 거절(기존)
  IN_PROGRESS       // 작업중
  COMPLETED         // 완료
  AWAITING_PAYMENT  // 입금대기
  PAYMENT_COMPLETED // 입금완료
}

// 접속 로그 타입 (향후 LOGOUT 등 확장)
enum AccessLogType {
  LOGIN
}

// 자동 업무일지용 활동 타입
enum ActivityLogActionType {
  TASK_CREATED
  TASK_COMPLETED
  COMMENT_ADDED
  SCHEDULE_CREATED  // 일정 등록
  LOGIN
  CHECK_IN   // 출근
  CHECK_OUT  // 퇴근
}

// 업무일지 제출 상태
enum DailyWorkLogStatus {
  DRAFT      // 작성 중
  SUBMITTED  // 제출됨
}

// 알림 타입
enum NotificationType {
  DEADLINE           // 마감 임박
  ASSIGNED           // 업무 배정
  COMMENT            // 댓글
  STAGNANT           // 장기 미진행
  BOARD_MENTION      // 게시판에서 태그(멘션)됨
  TASK_BODY_MENTION  // 업무 본문에서 @멘션
  CHAT_MESSAGE       // 채팅 메시지
  NOTICE_POSTED      // 공지 등록
  WORK_LOG_SUBMITTED // 업무일지 제출
  LEAVE_REQUEST      // 휴가 신청·승인 단계 알림
  PROJECT_COMPLETED  // 연계 견적/프로젝트 완료 처리 알림
  TASK_ORPHAN        // 담당자 미지정(고아) 업무 Cron
  TASK_DUE_D3        // 마감 3일 전 Cron
  TASK_DUE_D1        // 마감 1일 전 Cron
  TASK_DUE_OVERDUE   // 마감일 경과(당일 윈도우) Cron
  DAILY_DIGEST       // 일일 업무 다이제스트 Cron
  LEAVE_COMPENSATION // 연차 만료 시 수당 지급 필요(§61, 사용촉진 미실시)
}

/// 알림이 연결된 리소스(읽음 처리·백필용). 기존 type/link는 그대로 유지.
enum NotificationRelatedType {
  PROJECT
  TASK
  CHAT
  LEAVE
  ATTENDANCE
  FINANCE
  BOARD
  NOTICE
  WORK_LOG
  SYSTEM
}

// 워크스페이스 구분 (TEAM = 팀 공유, PERSONAL = 내 전용)
enum WorkspaceScope {
  TEAM
  PERSONAL
}

/// 첨부 미리보기 파이프라인 분류 (Drive 기준)
enum PreviewType {
  INLINE_NATIVE
  DRIVE_EMBED
  CONVERTED_PDF
  UNSUPPORTED
}

enum ConversionStatus {
  NONE
  PENDING
  DONE
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(USER)
  department    String?
  position      String?   // 직책
  currentProjectId String?
  currentProject   Project? @relation("UserCurrentProject", fields: [currentProjectId], references: [id], onDelete: SetNull)
  projects         Project[] @relation("ProjectTeamMembers")
  userNotes        UserNote[]
  joinDate      DateTime  @default(now())
  birthDate     DateTime? // 생년월일
  emailVerified DateTime?
  image         String?
  phone         String?   // 연락처
  workPhone     String?   // 업무 연락처
  workEmail     String?   // 업무 이메일
  bankAccount   String?   // 은행계좌번호
  residentId    String?   // 주민번호
  address       String?   // 주소지
  permissions   String?   // 계정별 사용 가능 기능 (JSON 배열, 없으면 역할 기본값 사용)
  badgePreset   String?   // 헤더 뱃지/아바타 스타일: default | violet | amber | emerald | blue
  preferredAiProvider String?   // AI 비서: gemini | openai | notebook | claude (null이면 서버 기본값)
  oneSignalPlayerId String?     // OneSignal 구독/Player ID (호환·레거시 필드명)
  playerId          String?     // OneSignal Player / subscription ID (마지막 등록 기기 — 레거시·디버그)
  /// 등록된 모든 기기의 구독 ID (웹 푸시 등). 발송 시 include_subscription_ids 에 병합 사용
  playerIds         String[]    @default([])
  lastActiveAt      DateTime?   // 마지막 접속 시각 (heartbeat — 온라인 여부 판단용)
  /// 회사/개인 모드 선호 — 다른 PC·쿠키 없을 때 복구 (app_mode 쿠키와 동기화)
  lastAppMode   String?
  /// true면 로그인·API 접근 불가(퇴사 등). 행·연관 기록은 유지.
  accountDisabled Boolean @default(false)
  /// 출퇴근 기록기 사원번호 (엑셀 임포트 매핑)
  attendanceMachineNo String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  attendances      Attendance[]
  attendanceRecords AttendanceRecord[]
  awayLogs          AwayLog[]
  schedules        Schedule[]         @relation("ScheduleOwner")
  assignedTasks    Task[]             @relation("TaskAssignee")
  taskAssigneeRows TaskAssignee[]
  createdTasks     Task[]             @relation("TaskCreator")
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  leaveAccruals    LeaveAccrual[]
  leaveAdjustmentsReceived LeaveAdjustment[] @relation("LeaveAdjustmentTarget")
  leaveAdjustmentsMade     LeaveAdjustment[] @relation("LeaveAdjustmentActor")
  csLoungePostsAuthored    CsLoungePost[]    @relation("CsLoungeAuthor")
  csLoungePostsDeleted     CsLoungePost[]    @relation("CsLoungeDeletedBy")
  csLoungeVotes            CsLoungeVote[]
  csClientsUpdated         CsClient[]        @relation("CsClientUpdatedBy")
  csClientAssignments      CsClientAssignment[]
  csClientAssignmentPeriods CsClientAssignmentPeriod[]
  csOrgMember              CsOrgReport?          @relation("CsOrgMember")
  csOrgReports             CsOrgReport[]         @relation("CsOrgManager")
  taskComments     TaskComment[]
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  scheduleInvitesSent    ScheduleInvite[] @relation("ScheduleInviteFrom")
  scheduleInvitesReceived ScheduleInvite[] @relation("ScheduleInviteTo")
  dailyMemos             DailyMemo[]
  googleCalendar         GoogleCalendarIntegration?
  naverCalendar          NaverCalendarIntegration?
  naverCalDav            NaverCalDavAccount?
  externalCalendarEvents ExternalCalendarEvent[]
  /// iCal 구독 URL용 비밀 토큰 (재발급 가능)
  icalFeedToken          String?   @unique
  paymentRequests        PaymentRequest[]
  paymentRequestAlerts   PaymentRequestAlert[]
  quotations            Quotation[]
  announcements         Announcement[]
  boardPosts            BoardPost[]
  boardPostsDeletedByMe BoardPost[]       @relation("BoardPostDeletedBy")
  boardPostComments    BoardPostComment[]
  boardPostRevisions   BoardPostRevision[]
  accessLogs            AccessLog[]
  activityLogs          ActivityLog[]
  taskRevisions         TaskRevision[]
  taskMentions          TaskMention[]
  dailyWorkLogs         DailyWorkLog[]
  notifications         Notification[]
  notificationLogs      NotificationLog[]
  oneSignalSubscriptions OneSignalSubscription[]
  projectsDeletedByMe   Project[]       @relation("ProjectDeletedBy")
  projectsCreated       Project[]       @relation("ProjectCreatedBy")
  projectsLastEdited    Project[]       @relation("ProjectLastEditedBy")
  tasksDeletedByMe      Task[]          @relation("TaskDeletedBy")
  aiSecretaryConversations AiConversation[]
  aiHubHistories         AiHubHistory[]
  taskMindmapStates      UserTaskMindmapState[]
  taskAuditLogs          TaskAuditLog[]          @relation("TaskAuditActor")
  userDailyUploadUsages  UserDailyUploadUsage[]
  driveFiles             DriveFile[]             @relation("DriveFileCreatedBy")
  driveFilesTrashedByMe  DriveFile[]             @relation("DriveFileTrashedBy")
  driveFilesUpdatedByMe  DriveFile[]             @relation("DriveFileUpdatedBy")
  driveActivityLogs      DriveActivityLog[]      @relation("DriveActivityActor")
  csToolClickLogs        CsToolClickLog[]
  @@index([currentProjectId])
}

/// /api/upload 기준 UTC 일일 누적 바이트 (사용자당 일 한도 — 5GB+ 누적 대비 BigInt)
model UserDailyUploadUsage {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  bytes     BigInt   @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([userId, dayKey])
}

// AI 허브: 클라이언트 히스토리/CRM 저장용
model AiHubHistory {
  id            String   @id @default(cuid())
  userId        String
  agentKey      String
  agentName     String
  input         String   @db.Text
  output        String   @db.Text
  selectedModel String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_hub_histories")
}

// Tasks 마인드맵: 노드 좌표·루트 스테이징·접힘·노드 스타일 등 (클라이언트 state 영속화)
model UserTaskMindmapState {
  userId    String
  scope     WorkspaceScope
  /// 전체 조감도 `__ALL__`, 미분류 `__UNASSIGNED__`, 프로젝트 뷰는 Project.id (FK 아님 — 예약값 호환)
  projectId String         @default("__ALL__")
  data      Json           @default("{}")
  /// 직전 저장본 1건(되돌리기용)
  previousPayload Json?
  previousSavedAt DateTime?
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope, projectId])
  @@index([userId])
}

model GoogleCalendarIntegration {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}

model NaverCalendarIntegration {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId])
}

/// 네이버 캘린더 읽기(CalDAV) 계정 — 앱 비밀번호는 AES-256-GCM으로 암호화 저장
model NaverCalDavAccount {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  naverId        String
  passwordCipher String
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([userId])
}

/// 외부 캘린더에서 읽어온 일정 스냅샷(.ics 업로드 등). 같은 UID+시작시각은 갱신.
model ExternalCalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// naver_ics 등 출처 구분
  source      String
  uid         String
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([userId, source, uid, startTime])
  @@index([userId, source, startTime])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  users     User[] @relation("ProjectTeamMembers")
  usersWithCurrentProject User[] @relation("UserCurrentProject")
  // 대표 견적서(1:1)
  quoteId     String?   @unique
  quote       Quotation? @relation("ProjectPrimaryQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  quoteAmount Int       @default(0)
  dueDate     DateTime?
  status      ProjectStatus @default(PREPARING)
  completedAt DateTime?
  /// 프로젝트 본문(게시판과 동일: text | html)
  description String?   @default("")
  contentType String      @default("text") @map("content_type") @db.VarChar(20)
  /// 본문 등에서 @멘션된 사용자 id — JSON ["userId1", …] (접근 권한·알림용)
  mentionedUserIds String @default("[]")
  tasks       Task[]
  quotationsLinked Quotation[] @relation("QuotationLinkedProject")
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdById String?
  createdBy User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedById String?
  lastEditedBy User? @relation("ProjectLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  userNotes UserNote[]
  driveFiles ProjectDriveFile[]
  notificationLogs NotificationLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([brandId, name])
  @@index([brandId])
  @@index([deletedAt])
  @@index([createdById])
  @@index([lastEditedById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model Attendance {
  id       String           @id @default(cuid())
  userId   String
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  /// 출근 요청 클라이언트 IP (프록시: x-forwarded-for 첫 주소)
  checkInIp  String?
  checkInUa  String?        @db.Text
  /// 퇴근 요청 클라이언트 IP
  checkOutIp String?
  checkOutUa String?        @db.Text
  status   AttendanceStatus @default(PRESENT)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// 기록기 엑셀·수동 근태 (대시보드 버튼 Attendance와 분리 — 급여 근거 보존)
model AttendanceRecord {
  id         String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// KST 해당일 00:00 (Attendance.date와 동일 규약)
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  source     AttendanceRecordSource
  /// 원본 타각 문자열 전체
  raw        String?
  /// 타각이 1개뿐인 날
  incomplete Boolean                 @default(false)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([userId, date, source])
  @@index([userId])
  @@index([date])
  @@index([source, date])
}

/// CS 이석(부재중). endedAt null = 현재 부재중. BATHROOM/SMOKING은 레거시 값.
model AwayLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AwayType
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, startedAt])
  @@index([endedAt])
}

model DailyMemo {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  content   String   @default("")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId])
}

// 구글 Keep 스타일 개인 메모 (다중 카드, HTML 본문, CRM 프로젝트에 선택 연결)
model UserNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("")
  content    String   @default("") @db.Text
  /// 본문 저장 형식: text(일반 텍스트) | html(HTML)
  contentType String  @default("text") @map("content_type") @db.VarChar(20)
  /// 게시판 구분과 동일: COMPANY | TRAINING | FREE | ANONYMOUS
  category   String   @default("COMPANY") @db.VarChar(32)
  attachments String  @default("[]") @db.Text // JSON: [{ "url": "/uploads/...", "name": "파일명" }]
  colorHex   String?
  /// 고정(핀) — 목록에서 맨 위에 표시
  pinned     Boolean  @default(false)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([userId])
  @@index([userId, pinned])
  @@index([projectId])
  @@index([category])
}

model Schedule {
  id          String         @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean        @default(false)
  userId      String
  user        User           @relation("ScheduleOwner", fields: [userId], references: [id], onDelete: Cascade)
  scope       WorkspaceScope @default(TEAM)
  invites     ScheduleInvite[]
  @@index([userId])
  @@index([startTime])
  @@index([scope])
  @@index([scope, userId, startTime(sort: Asc)])
}

model ScheduleInvite {
  id         String               @id @default(cuid())
  scheduleId String
  schedule   Schedule             @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User                 @relation("ScheduleInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User                 @relation("ScheduleInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     ScheduleInviteStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  @@unique([scheduleId, toUserId])
  @@index([toUserId])
}

// 업무 대분류/하위 계층 (스킬트리처럼 접기·펼치기, 이름·순서 변경)
model TaskCategory {
  id          String         @id @default(cuid())
  name        String
  parentId    String?
  parent      TaskCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    TaskCategory[] @relation("CategoryTree")
  sortOrder   Int            @default(0)
  isCollapsed Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tasks       Task[]
  @@index([parentId])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  /// 생성 UI 출처(스케줄 할일 목록 필터 등)
  creationSource TaskCreationSource @default(UNKNOWN)
  description  String?
  /// 목록·보드 카드 왼쪽 강조색 (#RRGGBB, 팔레트만 허용)
  color        String?
  dueDate      DateTime?
  isCompleted  Boolean        @default(false)
  status       TaskStatus     @default(TODO)
  priority     TaskPriority   @default(MEDIUM)
  /// 반복 업무 여부
  isRecurring  Boolean        @default(false)
  /// 반복 요일 JSON: "[1,2,3,4,5]" (1=월 … 7=일)
  recurringDays String?
  /// 반복 규칙(JSON): { freq: 'DAILY'|'WEEKLY'|'MONTHLY'|'HOURLY', interval: number, weekdays?: number[], monthDay?: number }
  /// - 신규 UI는 이 값을 우선 사용, 미설정이면 recurringDays(레거시)로 폴백
  recurringRule Json?
  /// 반복 업무 설명
  recurringMemo String?
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       Task?          @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Task[]         @relation("TaskTree")
  categoryId   String?
  category     TaskCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderIndex   Int            @default(0)
  isCollapsed  Boolean        @default(false)
  /// status 가 DONE 이 된 시각(자동 접힘·아카이브 기준). 표시 전용, 삭제 아님
  completedAt  DateTime?
  /// 아카이브 시각(null 이면 기본 목록에 포함). 표시 전용
  archivedAt   DateTime?
  scope        WorkspaceScope @default(TEAM)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?          @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedToId String?
  createdById  String?
  assignedTo   User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]
  comments    TaskComment[]
  // 추가 부모 연결 (다대다: 하나의 업무가 여러 대분류에 연결 가능)
  additionalParents TaskLink[] @relation("TaskLinkChild")
  additionalChildren TaskLink[] @relation("TaskLinkParent")
  assignees         TaskAssignee[]
  revisions        TaskRevision[]
  mentions         TaskMention[]
  notificationLogs NotificationLog[]
  auditLogs        TaskAuditLog[]
  @@index([assignedToId])
  @@index([assignedToId, dueDate])
  @@index([createdById])
  @@index([parentId])
  @@index([categoryId])
  @@index([dueDate])
  @@index([scope])
  @@index([deletedAt])
  // 목록: scope + deletedAt null 필터
  @@index([scope, deletedAt])
  @@index([projectId])
  @@index([archivedAt])
  @@index([status, completedAt])
  @@index([creationSource])
  @@index([assignedToId, creationSource, status])
}

// 업무 다중 담당자 (assignedToId 는 호환용으로 첫 담당자와 동기화)
model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

// 업무 본문 @멘션으로 호출된 사용자 (동기화·알림용)
model TaskMention {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

// 업무 간 추가 연결 (다대다 관계 - 하나의 하위 업무가 여러 상위 업무에 연결)
model TaskLink {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  parent    Task     @relation("TaskLinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     Task     @relation("TaskLinkChild", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

// 업무 수정 이력 (누가, 무엇을, 언제)
model TaskRevision {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  field     String   // title, description, status, dueDate, assignedToId, priority 등
  oldValue  String?  // 변경 전 값 (표시용 문자열)
  newValue  String?  // 변경 후 값 (표시용 문자열)
  createdAt DateTime @default(now())
  @@index([taskId])
  @@index([userId])
}

model TaskAttachment {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type     String   // LINK, VIDEO, FILE
  url      String
  name     String?
  createdAt DateTime @default(now())
  deletedAt DateTime?
  @@index([taskId])
  @@index([deletedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  @@index([taskId])
  @@index([userId])
  @@index([deletedAt])
}

/// 중요 필드 변경 감사(상태·담당·마감·프로젝트·아카이브·삭제·completedAt)
model TaskAuditLog {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User     @relation("TaskAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

model LeaveRequest {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  status    LeaveRequestStatus @default(PENDING)
  /// 취소 요청 시점의 기존 상태(PENDING|TEAM_LEAD_APPROVED|APPROVED). 승인 큐 라우팅/차감 복구에 사용
  cancelFromStatus String?
  reason    String?
  /// 최종 승인 시 FIFO로 차감한 LeaveAccrual 단위 기록(JSON). 취소 시 복구에 사용
  accrualAllocations Json?
  createdAt DateTime          @default(now())
  @@index([userId])
  @@index([startDate])
}

/// 입사기념일 기준 발생·소멸 단위(근기법 정합)
model LeaveAccrual {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               LeaveAccrualType
  days               Float
  /// KST 기준 발생일(중복 방지·표시용)
  accrualDateYmd     String            @db.VarChar(10)
  accruedAt          DateTime
  expiresAt          DateTime
  consumedDays       Float             @default(0)
  isExpired          Boolean           @default(false)
  expiredAt          DateTime?
  compensationOwed   Boolean           @default(false)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([userId, type, accrualDateYmd])
  @@index([userId, expiresAt])
  @@index([userId, isExpired])
  @@index([userId, type])
}

model LeaveBalance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int
  annualTotal     Float    @default(15)  // 당해 연도 부여 연차 일수
  annualCarryOver Float    @default(0)   // 전년도 이월 연차 일수
  annualUsed      Float    @default(0)   // 시스템에서 승인된 사용일
  manualDeduction Float    @default(0)   // 실제 사용한 일수 (최초 1회만 설정 가능)
  @@unique([userId, year])
  @@index([userId])
}

/// 관리자 연차 가감 이력(사유·조정자). 풀 반영은 LeaveAccrual MANUAL_ADJUSTMENT 또는 FIFO 차감.
model LeaveAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("LeaveAdjustmentTarget", fields: [userId], references: [id], onDelete: Cascade)
  days      Float
  reason    String
  actorId   String
  actor     User     @relation("LeaveAdjustmentActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Chat {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  name      String?  // 그룹명
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants ChatParticipant[]
  messages   ChatMessage[]
  @@index([updatedAt])
}

model ChatParticipant {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  /// 상대방 읽음 표시용 — 채팅방을 열어 메시지 목록을 마지막으로 본 시각 (PATCH /messages 시 갱신)
  lastReadAt DateTime?
  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  @@index([chatId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([chatId, isDeleted])
  @@index([userId])
}

// 회사 공지사항 (팀장 이상 작성) — 일정·투표 등 모임 기능 지원
model Announcement {
  id           String    @id @default(cuid())
  title        String
  content      String
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  // 일정(달력) — 모임 날짜/시간/장소
  eventDate    DateTime?
  eventEndDate DateTime?
  location     String?
  // 투표 — JSON: [{ "text": "선택지", "voterIds": ["userId1", ...] }]
  pollData     String?   // JSON string
  @@index([createdAt])
  @@index([createdById])
}

// 자료실 게시판 — 회사 자료·교육자료 등 (첨부파일 URL 배열)
model BoardPost {
  id          String            @id @default(cuid())
  title       String
  description String?           @default("")
  /// 본문: text(마크다운/노션형) | html(HTML)
  contentType String            @default("text") @map("content_type") @db.VarChar(20)
  category    String             // "COMPANY" | "TRAINING" | "FREE" | "ANONYMOUS"
  /// 익명 게시판(ANONYMOUS) 글 — DB에는 createdById 유지, 노출은 API/UI에서 마스킹 (대표만 상세에서 실명 확인)
  isAnonymous Boolean           @default(false)
  attachments String            @default("[]") // JSON: [{ "url": "/uploads/...", "name": "파일명" }]
  /// 본문에서 @멘션된 사용자 id — JSON ["userId1", …] (PERSONAL 글 접근·알림용)
  mentionedUserIds String       @default("[]")
  workspaceScope WorkspaceScope @default(TEAM) // PERSONAL: 임원·관리자 개인 자료(직원 목록에서 숨김)
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?             @relation("BoardPostDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  comments    BoardPostComment[]
  revisions   BoardPostRevision[]
  driveFiles  PostDriveFile[]
  @@index([createdAt])
  @@index([category])
  @@index([category, createdAt(sort: Desc)])
  @@index([createdById])
  @@index([deletedAt])
  @@index([workspaceScope])
}

// 게시판 댓글 (멘션된 사용자 ID 배열 저장 → 알림 발송)
model BoardPostComment {
  id             String    @id @default(cuid())
  boardPostId    String
  boardPost      BoardPost @relation(fields: [boardPostId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String
  mentionedIds   String    @default("[]") // JSON: ["userId1", "userId2"]
  createdAt      DateTime  @default(now())
  @@index([boardPostId])
  @@index([userId])
}

/// 게시글 수정 이력 (변경 필드 요약만 저장 — 본문 전체 JSON 미저장)
model BoardPostRevision {
  id            String    @id @default(cuid())
  boardPostId   String
  boardPost     BoardPost @relation(fields: [boardPostId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName      String
  /// 예: ["title","description"] — 구버전·수동 이관 시 null 가능
  changedFields Json?
  /// 구데이터(전체 JSON 등) 보관 시 표시는 "내용 수정"으로 통일
  legacyPayload Json?
  createdAt     DateTime  @default(now())
  @@index([boardPostId])
  @@index([boardPostId, createdAt])
  @@index([userId])
}

// 실시간 알림
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String           @default("")
  /// OneSignal 알림 ID(취소·전 디바이스 제거용) — 푸시 발송 성공 시 저장
  oneSignalNotificationId String?
  isRead    Boolean          @default(false)
  /// 읽은 시각(요구사항). 기존 isRead는 하위호환용으로 유지.
  readAt    DateTime?
  /// 연결 리소스(백필/자동읽음). null 가능(구 알림)
  relatedType NotificationRelatedType?
  relatedId  String?
  createdAt DateTime         @default(now())
  @@index([userId])
  @@index([userId, isRead])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([oneSignalNotificationId])
  @@index([userId, relatedType, relatedId])
  @@index([userId, readAt])
}

/// 웹 푸시 구독 1행 = 기기별 subscription id (User.playerIds 와 동기화, lastSeenAt 으로 좀비 판정)
model OneSignalSubscription {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String   @unique
  /// 등록·갱신(동일 기기 재등록) 시각 — 크론에서 미사용 구독 판정
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([lastSeenAt])
}

/// Cron·푸시 중복 방지 (삭제 아님, 발송 이력만)
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// ORPHAN | STALE | DUE_D3 | DUE_DDAY | DUE_PLUS1 | DUE_D1(레거시) | DUE_DAY(레거시) | DIGEST
  kind      String
  sentAt    DateTime @default(now())

  @@index([userId, kind, sentAt])
  @@index([taskId, kind])
  @@index([projectId, kind])
}

// 접속 로그 (하루 최초 접속·IP 기록, 출근 보조용)
model AccessLog {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String
  userAgent   String
  loggedInAt  DateTime      @default(now())
  type        AccessLogType @default(LOGIN)
  @@index([userId])
  @@index([loggedInAt])
}

// 자동 업무일지용 활동 로그 (업무 생성/완료/댓글/로그인/출퇴근 등)
model ActivityLog {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  ActivityLogActionType
  targetTitle String               // 관련 업무 제목 등 (예: '출근')
  timestamp   DateTime             @default(now())
  ipAddress   String?              // 출퇴근 시 기록 (수정 불가용)
  @@index([userId])
  @@index([timestamp])
}

// 자동 업무일지 (일별, 마크다운 내용 + 제출 상태)
model DailyWorkLog {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String            // YYYY-MM-DD
  content   String            @default("") // 마크다운, 사용자 수정 가능
  status    DailyWorkLogStatus @default(DRAFT)
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// 링크 미리보기 API 캐시 (게시판 등 동일 URL 반복 fetch 방지)
model LinkPreviewCache {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  siteName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([url])
}

/// HWP 등 변환 미리보기 캐시 (원본 driveFileId 기준 중복 방지)
model FilePreviewCache {
  id                 String             @id @default(cuid())
  driveFileId        String             @unique
  originalName       String
  originalMime       String
  previewType        PreviewType
  convertedDriveId   String?
  convertedAt        DateTime?
  conversionStatus   ConversionStatus   @default(NONE)
  conversionError    String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([driveFileId])
  @@index([conversionStatus])
}

/// Drive `anyone` 미리보기 권한 — 만료 후 Cron으로 회수 (영구 공개 방지)
model DrivePreviewPermissionExpiry {
  id             String   @id @default(cuid())
  driveFileId  String
  permissionId String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([driveFileId])
  @@index([expiresAt])
}

/// 드라이브 파일/폴더 메타데이터 (Google Drive 폴더형 탐색기 동기화)
model DriveFile {
  id             String  @id @default(cuid())
  driveFileId    String? @unique
  driveFolderId  String?
  name           String
  mimeType       String?
  size           BigInt?
  webViewLink    String?
  webContentLink String?
  thumbnailLink  String?

  parentId String?
  parent   DriveFile?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children DriveFile[] @relation("FolderChildren")
  isFolder Boolean     @default(false)

  description String?
  tags        String[] @default([])
  source      String   @default("google_drive")

  /// 동기화 루트 Google ID (탐색기/업로드 드라이브 구분). null = 마이그레이션 전 레거시
  rootId String?

  createdBy String?
  user      User? @relation("DriveFileCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  trashed   Boolean   @default(false)
  trashedAt DateTime?
  trashedBy String?
  trashedByUser User? @relation("DriveFileTrashedBy", fields: [trashedBy], references: [id], onDelete: SetNull)

  updatedBy String?
  updatedByUser User? @relation("DriveFileUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  projectFiles ProjectDriveFile[]
  postFiles    PostDriveFile[]
  activityLogs DriveActivityLog[]

  lastSyncedAt    DateTime?
  driveModifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([driveFolderId])
  @@index([isFolder])
  @@index([source])
  @@index([createdBy])
  @@index([rootId])
  @@index([rootId, parentId])
  @@index([trashed])
  @@index([trashed, rootId])
}

enum DriveActivityAction {
  DELETE
  RESTORE
  RENAME
  MOVE
}

model DriveActivityLog {
  id          String              @id @default(cuid())
  driveFileId String
  driveFile   DriveFile           @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  action      DriveActivityAction
  actorId     String
  actor       User                @relation("DriveActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  detail      String?
  createdAt   DateTime            @default(now())

  @@index([driveFileId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ProjectDriveFile {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileId    String
  file      DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([projectId, fileId])
  @@index([projectId])
  @@index([fileId])
}

model PostDriveFile {
  id        String    @id @default(cuid())
  postId    String
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileId    String
  file      DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, fileId])
  @@index([postId])
  @@index([fileId])
}

model Vendor {
  id            String   @id @default(cuid())
  name          String   // 업체명
  bankName      String   // 은행명
  accountNumber String   // 계좌번호
  ownerName     String   // 예금주 (입금자)
  contactPerson String?  // 담당자 (입금자와 다를 수 있음)
  category      String   // 인쇄/식대/용역 등
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id          String              @id @default(cuid())
  amount      Int                 // 금액 (원)
  status      PaymentRequestStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  completedAt DateTime?
  description String?             // 입금자명 변경 요청, 메모 등
  /// (레거시) 단일 첨부 URL. 신규 UI는 attachments(배열)를 사용.
  attachment  String?
  /// 주문 내역 이미지/엑셀 등 여러 첨부 (URL 배열)
  attachments Json?
  requesterId String?
  requester   User?               @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quotationId String?             // 정산 시 참고용 견적서 (선택)
  quotation   Quotation?          @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  alerts      PaymentRequestAlert[]
  @@index([requesterId])
  @@index([vendorId])
  @@index([status])
  @@index([requestedAt])
  @@index([quotationId])
}

// 자금이체 등록 시 결재 담당자(팀장)에게 알람
model PaymentRequestAlert {
  id        String          @id @default(cuid())
  requestId String
  request   PaymentRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime        @default(now())
  @@unique([requestId, userId])
  @@index([userId])
}

model Quotation {
  id               String            @id @default(cuid())
  quotationNumber  String            @unique // EST-YYYYMMDD-001
  title            String            // 건명
  clientName       String            // 거래처명
  validUntil       DateTime          // 유효기간
  totalAmount      Int               // 공급가액 (원)
  vatAmount        Int               // 부가세 (원)
  finalAmount      Int               // 총합계 (원)
  status           QuotationStatus   @default(IN_PROGRESS)
  issuedById       String?
  issuedBy         User?             @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt         DateTime          @default(now()) // 발행일시
  remarks          String?           // 특이사항/비고
  projectId        String?
  project          Project?          @relation("QuotationLinkedProject", fields: [projectId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            QuotationItem[]
  paymentRequests  PaymentRequest[]
  linkedAsPrimaryFor Project?      @relation("ProjectPrimaryQuote")
  @@index([issuedById])
  @@index([quotationNumber])
  // 목록 API: status 필터 + issuedAt 내림차순 / 전체 최신순
  @@index([status, issuedAt(sort: Desc)])
  @@index([issuedAt(sort: Desc)])
  @@index([projectId])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description  String   // 품목명
  quantity     Int      // 수량
  unitPrice    Int      // 단가 (원)
  amount       Int      // 공급가액 (원)
  sortOrder    Int      @default(0) // 표시 순서
  @@index([quotationId])
}

// 견적서 폼(템플릿) - 품목 기본값으로 새 견적서에 불러오기
model QuotationForm {
  id        String   @id @default(cuid())
  name      String   // 폼명 (예: 인쇄물 견적, 웹 개발 견적)
  itemsJson String   // JSON 배열: [{ description, quantity, unitPrice }]
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 부서/직책 마스터 (관리자가 생성, 기본정보에서 선택)
model Department {
  id        String   @id @default(cuid())
  name      String   // 부서명
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Position {
  id        String   @id @default(cuid())
  name      String   // 직책명
  sortOrder Int      @default(0)
  /// JSON 배열 문자열: 기능 키 목록. null이면 User.permissions 없을 때 역할(role) 기본 권한
  permissions String?
  createdAt DateTime @default(now())
}

// 견적서 등에 표시할 회사 정보 (싱글톤, 관리자만 수정)
// AI 비서 채팅 — 날짜(KST YYYY-MM-DD)별 스레드, 새로고침 후에도 유지
model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String   // YYYY-MM-DD (Asia/Seoul)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AiConversationMessage[]
  @@unique([userId, dateKey])
  @@index([userId])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user | assistant
  content        String         @db.Text
  createdAt      DateTime       @default(now())
  orderIndex     Int            @default(0)
  @@index([conversationId, orderIndex])
  @@map("ai_conversation_messages")
}

/// CS 링크 허브 — 외부 도구 바로가기
model CsTool {
  id          String   @id @default(cuid())
  name        String
  url         String
  category    String
  description String?
  clickCount  Int      @default(0)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clicks      CsToolClickLog[]

  @@index([isActive, order])
  @@index([category])
}

model CsToolClickLog {
  id        String   @id @default(cuid())
  toolId    String
  tool      CsTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickedAt DateTime @default(now())

  @@index([toolId, clickedAt])
  @@index([userId, clickedAt])
}

model CsLoungePost {
  id        String           @id @default(cuid())
  type      CsLoungePostType
  content   String
  nickname  String?
  authorId  String
  author    User             @relation("CsLoungeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  deletedAt DateTime?
  deletedBy String?
  deleter   User?            @relation("CsLoungeDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  votes     CsLoungeVote[]

  @@index([type, createdAt])
  @@index([deletedAt])
}

model CsLoungeVote {
  id     String             @id @default(cuid())
  postId String
  post   CsLoungePost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  CsLoungeVoteValue

  @@unique([postId, userId])
  @@index([postId])
}

model CsClient {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate String?
  endDate   String?
  note      String?
  isActive  Boolean  @default(true)
  /// ACTIVE=현재 담당, INCOMING=들어올 업체, OUTGOING=나갈 업체
  phase     String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?
  updater   User?    @relation("CsClientUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  deletedAt DateTime?
  assignments CsClientAssignment[]
  assignmentPeriods CsClientAssignmentPeriod[]

  @@index([isActive, name])
  @@index([deletedAt])
  @@index([phase])
}

model CsClientAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    CsClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleLabel String

  @@unique([clientId, userId])
  @@index([userId])
}

/// 담당 기간 — 월별 「어떤 브랜드를 며칠까지」 조회용
model CsClientAssignmentPeriod {
  id         String    @id @default(cuid())
  clientId   String
  client     CsClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedOn  String
  endedOn    String?
  roleLabel  String

  @@index([userId, startedOn])
  @@index([clientId, endedOn])
}

/// CS 조직도 공유 메모
model CsOrgMemo {
  id        String   @id
  content   String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

/// 입사 예정 직원 (아직 사원 계정이 없을 때)
model CsOrgHire {
  id        String   @id @default(cuid())
  name      String
  joinDate  String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// CS 조직도: 사원·부팀장이 누구 밑에 있는지 (설정 창고에서 지정)
model CsOrgReport {
  userId      String @id
  user        User   @relation("CsOrgMember", fields: [userId], references: [id], onDelete: Cascade)
  reportsToId String
  reportsTo   User   @relation("CsOrgManager", fields: [reportsToId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([reportsToId])
}

model CompanyInfo {
  id                   String   @id @default(cuid())
  name                 String   // 회사명
  businessNumber       String?  // 사업자등록번호
  representative       String?  // 대표자명
  address              String?  // 주소
  phone                String?  // 전화
  email                String?  // 이메일
  fax                  String?  // 팩스
  stampImageUrl        String?  // 도장 이미지 URL (견적서 발행용)
  logoUrl              String?  // 헤더 로고 이미지 URL (관리자 설정)
  transferExecutorIds   String?  // 이체 담당자 user id 목록 (JSON array: ["id1","id2"])
  /// 근로기준법 간이 「1년 미만 월차」상한 일수 (미설정 시 앱 기본 11일, 2026 기준 회사 신규 권장)
  annualLeaveMonthlyMaxUnderOneYear Int?
  /// 「1년 이상」연차 간이 발생 일수 (미설정 시 앱 기본 15일)
  annualLeaveDaysAfterFirstFullYear   Int?
  /// §61 사용촉진 절차를 시행한 경우(true): 만료 시 소멸만 기록. false: 수당 지급 필요로 표시
  useEncouragementEnabled             Boolean  @default(false)
  /// 월별·연간 개근 판정용 출근율 하한 (기본 0.8 = 80%)
  attendanceThreshold                 Float    @default(0.8)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
model IdleSession {
  id              String   @id @default(uuid())
  employeeId      String
  deviceId        String
  idleStart       DateTime
  idleEnd         DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([employeeId, idleStart])
  @@map("idle_sessions")
}

model DeviceStatus {
  deviceId      String   @id
  employeeId    String
  lastSeen      DateTime @default(now())
  isIdle        Boolean  @default(false)
  clientVersion String?
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@map("device_status")
}

